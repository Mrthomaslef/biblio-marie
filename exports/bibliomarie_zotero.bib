  author = {Dinh A and Barbier F and Bedos JP and Blot M and Cattoir V and Claessens YE and Duval X and Fillâtre P and Gautier M and Guegan Y and Jarraud S and Monnier AL and Lebeaux D and Loubet P and de Margerie C and Serayet P and Tandjaoui-Lambotte Y and Varon E and Welker Y and Basille D},
