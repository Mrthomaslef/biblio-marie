  author = {Vuotto F and Bru JP and Canoui E and Caseris M and Chopin MCC and Cohen R and Diamantis S and Dinh A and Fillatre P and Gauzit R and Gillet Y and Jonville-Bera AP and Lafaurie M and Lesprit P and Lorrot M and Lourtet J and Maulin L and Poitrenaud D and Pariente A and Raymond J and Strady C and Stahl JP and Varon E and Welker Y and Bonnet E},
