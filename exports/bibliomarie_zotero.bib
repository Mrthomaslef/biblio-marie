@article{robinson2026_41276461,
  title = {Evaluating Personal and Environmental Decolonization Strategies for Children With Skin and Soft Tissue Infection and Their Households - A Randomized Clinical Trial},
  author = {Robinson AL and Boyle MG and Hogan PG and Malone SM and Krauss MJ and Richardson LM and Sullivan ML and Walsh T and Tal R and Walsh L and Thompson RM and Parrish KL and Muenks CE and Burnham CD and Fritz SA},
  journal = {Clinical Infectious Diseases},
  year = {2026},
  volume = {82},
  number = {5},
  pages = {868-877},
  doi = {10.1093/cid/ciaf627},
  pmid = {41276461},
  url = {https://pubmed.ncbi.nlm.nih.gov/41276461/},
  abstract = {Après une infection cutanée à S. aureus chez un enfant, trois stratégies de décolonisation de 3 mois ont été comparées : personnelle (chlorhexidine, mupirocine), environnementale (désinfection des surfaces, linge) ou combinée. Aucune n'a réduit les infections à 3 mois. La stratégie combinée a réduit les récidives à 6 et 9 mois chez ceux qui avaient déjà eu une infection l'année précédente.}
}

@article{balamuth2026_42028918,
  title = {Balanced Fluid or 0.9% Saline in Children Treated for Septic Shock},
  author = {Balamuth F and Weiss SL and Long E and Thompson GC and Artis AS and Campos AB and Borland ML and Dalziel SR and Yock-Corrales A and Singh R and Williams A and Mickiewicz B and Hickey CP and Fitzgerald JC and Laskin BL and Hickey RW and Eckerle M and Alqurashi W and Alpern E and Ambroggio L and Badawy M and Baumer-Mouradian S and Berthelot S and Clukies LD and Craig S and Curtis SJ and Davis AL and Duffy S and Eisenberg MA and Emsley JG and Festekjian A and George S and Green R and Gripp KE and Jain PG and Jani S and Joubert GI and Judge P and Kam A and Kochar A and Koutroulis I and Kwok MY and Lane RD and Lithgow A and Lloyd J and Mansour K and McManemy JK and Morris C and Phillips N and Rao A and Rogers A and Sehgal A and Shayan Y and Silverman J and Tan E and Uspal NG and Vance C and Whyte E and Huang J and Freedman SB and Babl FE and Kuppermann N and PRoMPT BOLUS Investigators of the PECARN, PERC, and PREDICT Networks},
  journal = {The New England Journal of Medicine},
  year = {2026},
  volume = {395},
  number = {9},
  pages = {870-881},
  doi = {10.1056/nejmoa2601969},
  pmid = {42028918},
  url = {https://pubmed.ncbi.nlm.nih.gov/42028918/},
  abstract = {Chez l'enfant traité pour un choc septique, le remplissage par un cristalloïde balancé n'a pas fait mieux que le sérum salé isotonique sur le critère composite décès, nouvelle épuration extrarénale ou dysfonction rénale persistante (3,4 % vs 3,0 %). Le soluté balancé entraîne moins d'hyperchlorémie et d'hypernatrémie, mais un peu plus d'hyperlactatémie.}
}

@article{jabagi2026_41428474,
  title = {Nirsevimab vs RSVpreF Vaccine for Respiratory Syncytial Virus-Related Hospitalization in Newborns},
  author = {Jabagi MJ and Bertrand M and Gabet A and Kolla E and Olié V and Zureik M},
  journal = {JAMA},
  year = {2026},
  volume = {335},
  number = {9},
  pages = {787-798},
  doi = {10.1001/jama.2025.24082},
  pmid = {41428474},
  url = {https://pubmed.ncbi.nlm.nih.gov/41428474/},
  abstract = {À partir du Système national des données de santé, les nouveau-nés protégés par la vaccination maternelle RSVpreF (32–36 SA) ont été comparés à ceux ayant reçu le nirsévimab avant la sortie de maternité. Le nirsévimab est associé à un risque d'hospitalisation pour infection respiratoire basse à VRS plus faible de 26 %, et à environ 40 % de formes graves en moins (réanimation, ventilation, oxygène).}
}

@article{giamarellosbourboulis2026_41359996,
  title = {Precision Immunotherapy to Improve Sepsis Outcomes: The ImmunoSep Randomized Clinical Trial},
  author = {Giamarellos-Bourboulis EJ and Kotsaki A and Kotsamidi I and Efthymiou A and Koutsoukou V and Ehler J and Paridou A and Frantzeskaki F and Müller MCA and Pickkers P and Meylan S and Nikolopoulos I and Lupse M and Gavala A and Vlachogianni G and Solomonidi N and Alevizou A and Kondili E and Antoniadou E and Nakou M and Markou N and Hatziagelaki E and Prekates A and Komnos A and Bakkerus L and Slim MA and Dalekos GN and Karapanagiotou A and Ktena S and De Pascale G and Koulouras V and Psarrakis C and Massa E and Dakou K and Pazvanti C and Ioakeimidou A and Tsangaris I and Antonakos N and Vlaar APJ and Anisoglou S and Calandra T and Papaioannou V and Myrianthefs P and Patrani M and Alamanos I and Antonelli M and van der Meer JWM and van der Poll T and Wiersinga WJ and Ntaganou M and Gkeka E and Bauer M and Mouloudi E and Netea MG and ImmunoSep Study Group},
  journal = {JAMA},
  year = {2026},
  volume = {335},
  number = {9},
  pages = {775-786},
  doi = {10.1001/jama.2025.24175},
  pmid = {41359996},
  url = {https://pubmed.ncbi.nlm.nih.gov/41359996/},
  abstract = {Les patients septiques ont été classés selon leur profil immunitaire : syndrome d'activation macrophagique (ferritine > 4 420 ng/mL), traité par anakinra, ou immunoparalysie, traitée par interféron gamma. Cette stratégie de précision a doublé la proportion de patients dont le score SOFA s'améliore nettement à J9 (35 % vs 18 %), sans différence significative de mortalité à J28.}
}

@article{burstein2026_41359314,
  title = {Prediction of Bacteremia and Bacterial Meningitis Among Febrile Infants Aged 28 Days or Younger},
  author = {Burstein B and Waterfield T and Umana E and Xie J and Kuppermann N},
  journal = {JAMA},
  year = {2026},
  volume = {335},
  number = {5},
  pages = {425-433},
  doi = {10.1001/jama.2025.21454},
  pmid = {41359314},
  url = {https://pubmed.ncbi.nlm.nih.gov/41359314/},
  abstract = {La règle PECARN actualisée (bandelette urinaire négative, procalcitonine ≤ 0,5 ng/mL, polynucléaires neutrophiles ≤ 4 000/mm³) a été testée chez des nouveau-nés fébriles à terme, sans aspect toxique. Elle identifie 41 % de nourrissons à bas risque avec une sensibilité de 94 % et une valeur prédictive négative de 99,4 % pour les bactériémies et méningites bactériennes. Aucune méningite bactérienne n'a été classée à tort comme bas risque.}
}

@article{averbuch2025_41314221,
  title = {Empirical and targeted antimicrobial therapy in patients with febrile neutropenia and haematological malignancy or after haematopoietic cell transplantation: recommendations from the 10th European Conference on Infections in Leukaemia},
  author = {Averbuch D and Vanbiervliet Y and Baccelli F and Mikulska M and Neofytos D and Garcia-Vidal C and Aguilar-Guisado M and Blijlevens N and Munoz P and Cordonnier C and Akova M and Calandra T},
  journal = {The Lancet Infectious Diseases},
  year = {2025},
  volume = {26},
  number = {6},
  pages = {e232-e247},
  doi = {10.1016/s1473-3099(25)00619-x},
  pmid = {41314221},
  url = {https://pubmed.ncbi.nlm.nih.gov/41314221/},
  abstract = {La 10e Conférence européenne sur les infections en leucémie propose une approche personnalisée de la neutropénie fébrile, guidée par l'écologie locale et les facteurs de risque individuels. Chez le patient stable, sans colonisation à BGN résistant et en zone de faible résistance, une monothérapie épargnant les carbapénèmes est recommandée. Une désescalade puis un arrêt des antibiotiques sont possibles même si les neutrophiles restent bas.}
}

@article{burdet2025_41115439,
  title = {Cloxacillin versus cefazolin for meticillin-susceptible Staphylococcus aureus bacteraemia (CloCeBa): a prospective, open-label, multicentre, non-inferiority, randomised clinical trial},
  author = {Burdet C and Saïdani N and Dupieux C and Lemaignen A and Canouï E and Surgers L and Vareil MO and Lefort A and Lepeule R and Peiffer-Smadja N and Charmillon A and Le Moing V and Boutoille D and Tolsma V and Abgrall S and Wolff M and Tattevin P and Esposito-Farèse M and Vandenesch F and Duval X and Tubiana S and Lescure FX and CloCeBa Study Group},
  journal = {The Lancet},
  year = {2025},
  volume = {406},
  number = {10517},
  pages = {2349-2359},
  doi = {10.1016/s0140-6736(25)01624-1},
  pmid = {41115439},
  url = {https://pubmed.ncbi.nlm.nih.gov/41115439/},
  abstract = {Premier essai randomisé comparant céfazoline et cloxacilline pendant les 7 premiers jours de traitement d'une bactériémie à SAMS, hors matériel intravasculaire et infection neuroméningée. Le succès à J90 est identique (75 % vs 74 %) et la céfazoline entraîne moins d'événements indésirables graves et beaucoup moins d'insuffisance rénale aiguë.}
}

@article{zar2025_40961446,
  title = {Clesrovimab for Prevention of RSV Disease in Healthy Infants},
  author = {Zar HJ and Simões EAF and Madhi SA and Ramilo O and Senders SD and Shepard JS and Laoprasopwattana K and Piedrahita J and Novoa JM and Vargas SL and Dionne M and Jackowska T and Liu E and Ishihara Y and Ikeda K and Zhang Y and Railkar RA and Lutkiewicz J and Vora KA and Zang X and Maas BM and Lee AW and Guerra A and Sinha A and CLEVER (MK-1654-004) Study Group},
  journal = {The New England Journal of Medicine},
  year = {2025},
  volume = {393},
  number = {13},
  pages = {1292-1303},
  doi = {10.1056/nejmoa2502984},
  pmid = {40961446},
  url = {https://pubmed.ncbi.nlm.nih.gov/40961446/},
  abstract = {Le clesrovimab, anticorps à longue durée d'action dirigé contre le site IV de la protéine F du VRS, a été administré en une injection unique de 105 mg chez des nourrissons prématurés et à terme. Il réduit de 60 % les infections respiratoires basses à VRS ayant nécessité une consultation au cours des 150 jours suivants, et réduit aussi les hospitalisations, avec une tolérance comparable au placebo.}
}

@article{turner2025_40802264,
  title = {Dalbavancin for Treatment of Staphylococcus aureus Bacteremia: The DOTS Randomized Clinical Trial},
  author = {Turner NA and Hamasaki T and Doernberg SB and Lodise TP and King HA and Ghazaryan V and Cosgrove SE and Jenkins TC and Liu C and Sharma S and Zaharoff S and Wahid L and Renard VJ and Cook P and Raad I and Hachem R and Chaftari AM and Sims M and DeMarco C and Miller LG and McCarthy MW and Morse CG and Lucasti C and Forrest GN and Cherabuddi K and Polk C and Fazili T and Rupp ME and Thompson GR 3rd and Kim K and Strnad L and Schnee AE and McKinnell JA and Ramesh M and Silveira FP and McCarty TP and Lee TC and McDonald EG and Paolino K and Wiegand K and Wall A and Riccobene T and Patel R and Rappo U and Evans S and Chambers HF and Fowler VG Jr and Holland TL and Antibacterial Resistance Leadership Group},
  journal = {JAMA},
  year = {2025},
  doi = {10.1001/jama.2025.12543},
  pmid = {40802264},
  url = {https://pubmed.ncbi.nlm.nih.gov/40802264/},
  abstract = {Chez des adultes avec une bactériémie compliquée à S. aureus et des hémocultures négativées, deux doses de dalbavancine (1 500 mg à J1 et J8) ont été comparées à 4 à 8 semaines de traitement IV standard. La dalbavancine n'est pas supérieure sur le classement DOOR, mais son efficacité clinique est non inférieure (73 % vs 72 %), sans cathéter de longue durée.}
}

