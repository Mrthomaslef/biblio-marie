@article{st2025_39826968,
  title = {Appendicectomy versus antibiotics for acute uncomplicated appendicitis in children: an open-label, international, multicentre, randomised, non-inferiority trial},
  author = {St Peter SD and Noel-MacDonnell JR and Hall NJ and Eaton S and Suominen JS and Wester T and Svensson JF and Almström M and Muenks EP and Beaudin M and Piché N and Brindle M and MacRobie A and Keijzer R and Engstrand Lilja H and Kassa AM and Jancelewicz T and Butter A and Davidson J and Skarsgard E and Te-Lu Y and Nah S and Willan AR and Pierro A},
  journal = {The Lancet},
  year = {2025},
  volume = {405},
  number = {10474},
  pages = {233-240},
  doi = {10.1016/s0140-6736(24)02420-6},
  pmid = {39826968},
  url = {https://pubmed.ncbi.nlm.nih.gov/39826968/},
  abstract = {Chez l'enfant suspect d'appendicite non perforée, le traitement antibiotique seul a été comparé à l'appendicectomie d'emblée. À 12 mois, l'échec du traitement est survenu chez 34 % des enfants traités par antibiotiques contre 7 % des opérés (essentiellement des appendicectomies blanches). Avec une marge de non-infériorité de 20 %, l'antibiothérapie seule est déclarée inférieure à la chirurgie.}
}

@article{balance2024_39565030,
  title = {Antibiotic Treatment for 7 versus 14 Days in Patients with Bloodstream Infections},
  author = {BALANCE Investigators, for the Canadian Critical Care Trials Group, the Association of Medical Microbiology and Infectious Disease Canada Clinical Research Network, the Australian and New Zealand Intensive Care Society Clinical Trials Group, and the Australasian Society for Infectious Diseases Clinical Research Network and Daneman N and Rishu A and Pinto R and Rogers BA and Shehabi Y and Parke R and Cook D and Arabi Y and Muscedere J and Reynolds S and Hall R and Dwivedi DB and McArthur C and McGuinness S and Yahav D and Coburn B and Geagea A and Das P and Shin P and Detsky M and Morris A and Fralick M and Powis JE and Kandel C and Sligl W and Bagshaw SM and Singhal N and Belley-Cote E and Whitlock R and Khwaja K and Morpeth S and Kazemi A and Williams A and MacFadden DR and McIntyre L and Tsang J and Lamontagne F and Carignan A and Marshall J and Friedrich JO and Cirone R and Downing M and Graham C and Davis J and Duan E and Neary J and Evans G and Alraddadi B and Al Johani S and Martin C and Elsayed S and Ball I and Lauzier F and Turgeon A and Stelfox HT and Conly J and McDonald EG and Lee TC and Sullivan R and Grant J and Kagan I and Young P and Lawrence C and O'Callaghan K and Eustace M and Choong K and Aslanian P and Buehner U and Havey T and Binnie A and Prazak J and Reeve B and Litton E and Lother S and Kumar A and Zarychanski R and Hoffman T and Paterson D and Daley P and Commons RJ and Charbonney E and Naud JF and Roberts S and Tiruvoipati R and Gupta S and Wood G and Shum O and Miyakis S and Dodek P and Kwok C and Fowler RA and The BALANCE Investigators, for the Canadian Critical Care Trials Group, the Association of Medical Microbiology and Infectious Disease Canada Clinical Research Network, the Australian and New Zealand Intensive Care Society Clinical Trials Group, and the Australasian Society for Infectious Diseases Clinical Research Network
},
  journal = {The New England Journal of Medicine},
  year = {2024},
  volume = {392},
  number = {11},
  pages = {1065-1078},
  doi = {10.1056/nejmoa2404991},
  pmid = {39565030},
  url = {https://pubmed.ncbi.nlm.nih.gov/39565030/},
  abstract = {Chez des patients hospitalisés, dont plus de la moitié en réanimation, avec une bactériémie (principalement à BGN, hors S. aureus et immunodépression sévère), 7 jours d'antibiotiques sont non inférieurs à 14 jours sur la mortalité à 90 jours (14,5 % vs 16,1 %). Les résultats sont homogènes quels que soient le patient, le germe ou le foyer infectieux.}
}

@article{segers2024_39540734,
  title = {Safety, outcomes, and pharmacokinetics of isavuconazole as a treatment for invasive fungal diseases in pediatric patients: a non-comparative phase 2 trial},
  author = {Segers H and Deville JG and Muller WJ and Manzanares A and Desai A and Neely M and Bordon V and Hanisch B and Lassaletta A and Fisher BT and Autmizguine J and Groll AH and Sinnar S and Croos-Dabrera R and Engelhardt M and Jones M and Kovanda LL and Arrieta AC},
  journal = {Antimicrobial Agents and Chemotherapy},
  year = {2024},
  volume = {68},
  number = {12},
  pages = {e0048424},
  doi = {10.1128/aac.00484-24},
  pmid = {39540734},
  url = {https://pubmed.ncbi.nlm.nih.gov/39540734/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblio-marie/pdfs/PMID_39540734.pdf:application/pdf},
  abstract = {Chez des enfants atteints d'aspergillose ou de mucormycose invasive (prouvée, probable ou possible), l'isavuconazole à 10 mg/kg/j de prodrogue (maximum 372 mg) a permis une réponse globale favorable chez 55 % des patients en fin de traitement, avec une mortalité à J42 de 6,5 %. L'exposition est comparable à celle de l'adulte ; une dose de 15 mg/kg pourrait être nécessaire avant 3 ans.}
}

@article{rodrigues2024_39092529,
  title = {Resurgence of Bordetella pertussis, including one macrolide-resistant isolate, France, 2024},
  author = {Rodrigues C and Bouchez V and Soares A and Trombert-Paolantoni S and Aït El Belghiti F and Cohen JF and Armatys N and Landier A and Blanchot T and Hervo M and REMICOQ study group and Toubiana J and Brisse S},
  journal = {Eurosurveillance},
  year = {2024},
  volume = {29},
  number = {31},
  doi = {10.2807/1560-7917.es.2024.29.31.2400459},
  pmid = {39092529},
  url = {https://pubmed.ncbi.nlm.nih.gov/39092529/},
  abstract = {Après trois années d'incidence quasi nulle, la France a connu en 2024 une forte reprise de la coqueluche : 5 616 PCR positives entre janvier et mai, soit près d'un test sur quatre. Les souches séquencées produisent majoritairement la pertactine et FIM2, à la différence des années pré-COVID. Un isolat résistant aux macrolides a été identifié.}
}

@article{assad2024_38986058,
  title = {Nirsevimab and Hospitalization for RSV Bronchiolitis},
  author = {Assad Z and Romain AS and Aupiais C and Shum M and Schrimpf C and Lorrot M and Corvol H and Prevost B and Ferrandiz C and Giolito A and Valtuille Z and Bendavid M and Cohen JF and Toubiana J and de Pontual L and Delande CF and Levy M and See P and Cohen R and Levy C and Angoulvant F and Lenglart L and Gits-Muselli M and Biran V and Diallo K and Alemede O and El Hebil MM and Durrmeyer X and Labouret G and Casanovas N and Hallak B and Maréchal O and Jung C and Bréhin C and Ouldali N},
  journal = {The New England Journal of Medicine},
  year = {2024},
  volume = {391},
  number = {2},
  pages = {144-154},
  doi = {10.1056/nejmoa2314885},
  pmid = {38986058},
  url = {https://pubmed.ncbi.nlm.nih.gov/38986058/},
  abstract = {Première évaluation en vie réelle du nirsévimab lors de la saison 2023-2024 en France. Chez les nourrissons de moins de 12 mois, l'efficacité ajustée contre l'hospitalisation pour bronchiolite à VRS atteint 83 %. La protection persiste pour les formes graves : 70 % contre l'admission en soins critiques et 67 % contre le recours à une assistance ventilatoire.}
}

@article{strunk2024_38944044,
  title = {Neonatal bacterial sepsis},
  author = {Strunk T and Molloy EJ and Mishra A and Bhutta ZA},
  journal = {The Lancet},
  year = {2024},
  volume = {404},
  number = {10449},
  pages = {277-293},
  doi = {10.1016/s0140-6736(24)00495-1},
  pmid = {38944044},
  url = {https://pubmed.ncbi.nlm.nih.gov/38944044/},
  abstract = {Le sepsis néonatal reste, avec la prématurité, responsable de près de la moitié des décès d'enfants de moins de 5 ans dans le monde. Contrairement à l'adulte, il n'existe pas de définition consensuelle du sepsis néonatal, ce qui complique la pratique, la surveillance et la recherche. La revue fait le point sur les limites de l'hémoculture, les nouveaux outils diagnostiques, l'antibiothérapie et surtout la prévention.}
}

@article{valisena2024_38543601,
  title = {The Kocher-Caird Criteria for Pediatric Septic Arthritis of the Hip: Time for a Change in the Kingella Era?},
  author = {Valisena S and De Marco G and Vazquez O and Cochard B and Steiger C and Dayer R and Ceroni D},
  journal = {Microorganisms},
  year = {2024},
  volume = {12},
  number = {3},
  pages = {550},
  doi = {10.3390/microorganisms12030550},
  pmid = {38543601},
  url = {https://pubmed.ncbi.nlm.nih.gov/38543601/},
  abstract = {Les critères de Kocher (fièvre > 38,5 °C, refus d'appui, VS > 40 mm/h, leucocytes > 12 000/mm³), complétés par la CRP > 20 mg/L de Caird, servent depuis vingt ans à distinguer l'arthrite septique de hanche de la synovite transitoire. Ils ont été établis avant la reconnaissance de Kingella kingae, responsable d'infections peu inflammatoires, ce qui expose à des faux négatifs.}
}

@article{sanchezpinto2024_38245897,
  title = {Development and Validation of the Phoenix Criteria for Pediatric Sepsis and Septic Shock},
  author = {Sanchez-Pinto LN and Bennett TD and DeWitt PE and Russell S and Rebull MN and Martin B and Akech S and Albers DJ and Alpern ER and Balamuth F and Bembea M and Chisti MJ and Evans I and Horvat CM and Jaramillo-Bustamante JC and Kissoon N and Menon K and Scott HF and Weiss SL and Wiens MO and Zimmerman JJ and Argent AC and Sorce LR and Schlapbach LJ and Watson RS and Society of Critical Care Medicine Pediatric Sepsis Definition Task Force and Biban P and Carrol E and Chiotos K and Flauzino De Oliveira C and Hall MW and Inwald D and Ishimine P and Levin M and Lodha R and Nadel S and Nakagawa S and Peters MJ and Randolph AG and Ranjit S and Souza DC and Tissieres P and Wynn JL},
  journal = {JAMA},
  year = {2024},
  volume = {331},
  number = {8},
  pages = {675-686},
  doi = {10.1001/jama.2024.0196},
  pmid = {38245897},
  url = {https://pubmed.ncbi.nlm.nih.gov/38245897/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblio-marie/pdfs/PMID_38245897.pdf:application/pdf},
  abstract = {La task force de la Society of Critical Care Medicine a dérivé et validé un nouveau score, le Phoenix Sepsis Score, à partir de quatre défaillances d'organe (respiratoire, cardiovasculaire, coagulation, neurologique). Le sepsis est défini par un score ≥ 2 chez un enfant suspect d'infection, et le choc septique par un sepsis avec au moins 1 point cardiovasculaire. Ces critères remplacent les critères IPSCC 2005 fondés sur le SIRS.}
}

@article{montini2024_38146260,
  title = {Short Oral Antibiotic Therapy for Pediatric Febrile Urinary Tract Infections: A Randomized Trial},
  author = {Montini G and Tessitore A and Console K and Ronfani L and Barbi E and Pennesi M and STOP Trial Group},
  journal = {Pediatrics},
  year = {2024},
  volume = {153},
  number = {1},
  pages = {e2023062598},
  doi = {10.1542/peds.2023-062598},
  pmid = {38146260},
  url = {https://pubmed.ncbi.nlm.nih.gov/38146260/},
  abstract = {Chez l'enfant en bon état général avec une infection urinaire fébrile non compliquée, 5 jours d'amoxicilline-acide clavulanique per os (50 mg/kg/j) sont non inférieurs à 10 jours. Les récidives à 30 jours étaient même moins fréquentes dans le bras court (2,8 % vs 14,3 %).}
}

@article{peters2023_38048787,
  title = {Conservative versus liberal oxygenation targets in critically ill children (Oxy-PICU): a UK multicentre, open, parallel-group, randomised clinical trial},
  author = {Peters MJ and Gould DW and Ray S and Thomas K and Chang I and Orzol M and O'Neill L and Agbeko R and Au C and Draper E and Elliot-Major L and Giallongo E and Jones GAL and Lampro L and Lillie J and Pappachan J and Peters S and Ramnarayan P and Sadique Z and Rowan KM and Harrison DA and Mouncey PR and Oxy-PICU Investigators of the Paediatric Critical Care Society Study Group (PCCS-SG)},
  journal = {The Lancet},
  year = {2023},
  volume = {403},
  number = {10424},
  pages = {355-364},
  doi = {10.1016/s0140-6736(23)01968-2},
  pmid = {38048787},
  url = {https://pubmed.ncbi.nlm.nih.gov/38048787/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblio-marie/pdfs/PMID_38048787.pdf:application/pdf},
  abstract = {Chez l'enfant admis en urgence en réanimation et ventilé invasivement, une cible d'oxygénation conservatrice (SpO₂ 88–92 %) a été comparée à une cible libérale (SpO₂ > 94 %). La stratégie conservatrice a légèrement mais significativement réduit la durée des suppléances d'organe ou le décès à 30 jours, sans excès d'événements indésirables.}
}

@article{sarmiento2023_37880823,
  title = {Assessing Risk for Complications in Acute Hematogenous Osteomyelitis in Children: Validation of 2 Predictive Scores},
  author = {Sarmiento Clemente A and McNeil JC and Hultén KG and Vallejo JG and Scheurer ME and Kaplan SL},
  journal = {Journal of the Pediatric Infectious Diseases Society},
  year = {2023},
  volume = {12},
  number = {12},
  pages = {610-617},
  doi = {10.1093/jpids/piad095},
  pmid = {37880823},
  url = {https://pubmed.ncbi.nlm.nih.gov/37880823/},
  abstract = {Les scores A-SCORE (complications aiguës) et C-SCORE (complications chroniques) ont été validés sur une cohorte externe d'ostéomyélites aiguës hématogènes. L'A-SCORE prédit bien une évolution aiguë compliquée (aire sous la courbe 0,87, VPN 92 %). Le C-SCORE est moins spécifique que prévu mais garde une bonne VPN (94 %) pour les séquelles chroniques.}
}

@article{bonnet2023_37952582,
  title = {Clinical practice recommendations for infectious disease management of diabetic foot infection (DFI) - 2023 SPILF},
  author = {Bonnet E and Maulin L and Senneville E and Castan B and Fourcade C and Loubet P and Poitrenaud D and Schuldiner S and Sotto A and Lavigne JP and Lesprit P and individual members of the “Review group”},
  journal = {Infectious Diseases Now},
  year = {2023},
  volume = {54},
  number = {1},
  pages = {104832},
  doi = {10.1016/j.idnow.2023.104832},
  pmid = {37952582},
  url = {https://pubmed.ncbi.nlm.nih.gov/37952582/},
  abstract = {La SPILF actualise ses recommandations de 2006, en complément de celles de l'IWGDF, en se concentrant sur le diagnostic microbiologique et l'antibiothérapie. La gravité doit être classée selon l'IWGDF, les prélèvements ne se font qu'en cas de signes cliniques d'infection, et l'antibiothérapie probabiliste doit toujours couvrir le S. aureus sensible à la méticilline. En cas d'ostéite, radiographie standard et biopsie osseuse.}
}

@article{peel2023_37851875,
  title = {Trial of Vancomycin and Cefazolin as Surgical Prophylaxis in Arthroplasty},
  author = {Peel TN and Astbury S and Cheng AC and Paterson DL and Buising KL and Spelman T and Tran-Duy A and Adie S and Boyce G and McDougall C and Molnar R and Mulford J and Rehfisch P and Solomon M and Crawford R and Harris-Brown T and Roney J and Wisniewski J and de Steiger R and ASAP Trial Group},
  journal = {The New England Journal of Medicine},
  year = {2023},
  volume = {389},
  number = {16},
  pages = {1488-1498},
  doi = {10.1056/nejmoa2301401},
  pmid = {37851875},
  url = {https://pubmed.ncbi.nlm.nih.gov/37851875/},
  abstract = {Chez des adultes non colonisés à SARM opérés d'une arthroplastie, l'ajout de 1,5 g de vancomycine à la céfazoline n'a pas réduit les infections du site opératoire à 90 jours (4,5 % vs 3,5 %). Chez les prothèses de genou, elles étaient même plus fréquentes avec la vancomycine, et les réactions d'hypersensibilité deux fois plus nombreuses.}
}

@article{lorrot2023_37741341,
  title = {Antibiotic therapy for osteoarticular infections in 2023: Proposals from the Pediatric Infectious Pathology Group (GPIP)},
  author = {Lorrot M and Gillet Y and Basmaci R and Bréhin C and Dommergues MA and Favier M and Jeziorski E and Panetta L and Pinquier D and Ouziel A and Grimprel E and Cohen R},
  journal = {Infectious Diseases Now},
  year = {2023},
  volume = {53},
  number = {8S},
  pages = {104789},
  doi = {10.1016/j.idnow.2023.104789},
  pmid = {37741341},
  url = {https://pubmed.ncbi.nlm.nih.gov/37741341/},
  abstract = {Le GPIP actualise la prise en charge des IOA de l'enfant, le plus souvent hématogènes et survenant avant 5 ans. Staphylococcus aureus est en cause à tout âge et Kingella kingae est très fréquent entre 6 mois et 4 ans. L'antibiothérapie probabiliste repose sur la céfazoline IV à forte dose, avec un relais oral précoce après environ 3 jours dans les formes non compliquées.}
}

@article{gillet2023_37741342,
  title = {Antibiotic treatment of neuro-meningeal infections},
  author = {Gillet Y and Grimprel E and Haas H and Yaghy M and Dubos F and Cohen R},
  journal = {Infectious Diseases Now},
  year = {2023},
  volume = {53},
  number = {8S},
  pages = {104788},
  doi = {10.1016/j.idnow.2023.104788},
  pmid = {37741342},
  url = {https://pubmed.ncbi.nlm.nih.gov/37741342/},
  abstract = {Grâce au vaccin pneumococcique conjugué et à l'observatoire national des méningites, aucune méningite à pneumocoque résistant aux C3G n'a été observée récemment en France. Le GPIP limite donc la vancomycine à la phase secondaire, si la CMI de la C3G est > 0,5 mg/L, et abandonne l'association ciprofloxacine-céfotaxime pour les méningites à E. coli du nouveau-né. Les abcès cérébraux communautaires associent céfotaxime et métronidazole.}
}

@article{cohen2023_37730165,
  title = {Antimicrobial treatment of ENT infections},
  author = {Cohen R and Madhi F and Thollot F and Hau I and Vie le Sage F and Lemaître C and Magendie C and Werner A and Gelbert N and Cohen JF and Couloigner V},
  journal = {Infectious Diseases Now},
  year = {2023},
  volume = {53},
  number = {8S},
  pages = {104785},
  doi = {10.1016/j.idnow.2023.104785},
  pmid = {37730165},
  url = {https://pubmed.ncbi.nlm.nih.gov/37730165/},
  abstract = {Les infections ORL sont les infections les plus fréquentes de l'enfant et la première cause de prescription d'antibiotiques, alors qu'elles sont majoritairement virales. Le GPIP rappelle les situations sans antibiotique, la place du TDR streptococcique dans l'angine et les indications restreintes dans l'otite moyenne aiguë. L'amoxicilline reste le traitement de première ligne.}
}

@article{morello2023_37702442,
  title = {Antibiotic Prophylaxis in Infants with Grade III, IV, or V Vesicoureteral Reflux},
  author = {Morello W and Baskin E and Jankauskiene A and Yalcinkaya F and Zurowska A and Puccio G and Serafinelli J and La Manna A and Krzemień G and Pennesi M and La Scola C and Becherucci F and Brugnara M and Yuksel S and Mekahli D and Chimenz R and De Palma D and Zucchetta P and Vajauskas D and Drozdz D and Szczepanska M and Caliskan S and Lombet J and Minoli DG and Guarino S and Gulleroglu K and Ruzgiene D and Szmigielska A and Barbi E and Ozcakar ZB and Kranz A and Pasini A and Materassi M and De Rechter S and Ariceta G and Weber LT and Marzuillo P and Alberici I and Taranta-Janusz K and Caldas Afonso A and Tkaczyk M and Català M and Cabrera Sevilla JE and Mehls O and Schaefer F and Montini G and PREDICT Study Group},
  journal = {The New England Journal of Medicine},
  year = {2023},
  volume = {389},
  number = {11},
  pages = {987-997},
  doi = {10.1056/nejmoa2300161},
  pmid = {37702442},
  url = {https://pubmed.ncbi.nlm.nih.gov/37702442/},
  abstract = {Chez des nourrissons de 1 à 5 mois avec un reflux de grade III à V, sans infection urinaire antérieure, l'antibioprophylaxie continue pendant 2 ans réduit le risque de première infection urinaire (21 % vs 36 %). Il faut traiter 7 enfants pour éviter une infection, sans effet sur les cicatrices rénales ni sur le débit de filtration glomérulaire, et au prix de germes plus résistants.}
}

@article{lassoued2023_37180594,
  title = {Unexpected Increase in Invasive Group A Streptococcal Infections in Children After Respiratory Viruses Outbreak in France: A 15-Year Time-Series Analysis},
  author = {Lassoued Y and Assad Z and Ouldali N and Caseris M and Mariani P and Birgy A and Bonacorsi S and Bidet P and Faye A},
  journal = {Open Forum Infectious Diseases},
  year = {2023},
  volume = {10},
  number = {5},
  pages = {ofad188},
  doi = {10.1093/ofid/ofad188},
  pmid = {37180594},
  url = {https://pubmed.ncbi.nlm.nih.gov/37180594/},
  abstract = {Une analyse de 15 ans de données pédiatriques françaises montre une hausse inattendue des infections invasives à streptocoque du groupe A à partir d'octobre 2022, dominée par les pleurésies purulentes. Cette hausse est survenue en même temps qu'une circulation intense des virus respiratoires, après la levée des mesures barrières.}
}
