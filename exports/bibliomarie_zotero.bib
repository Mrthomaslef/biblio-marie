@article{sigmund2025_40463685,
  title = {Debridement, antimicrobial therapy, and implant retention (DAIR) as curative strategy for acute periprosthetic hip and knee infections: a position paper of the European Bone & Joint Infection Society (EBJIS)},
  author = {Sigmund IK and Ferry T and Sousa R and Soriano A and Metsemakers WJ and Clauss M and Trebse R and Wouthuyzen-Bakker M},
  journal = {Journal of Bone and Joint Infection},
  year = {2025},
  volume = {10},
  number = {2},
  pages = {101-138},
  doi = {10.5194/jbji-10-101-2025},
  pmid = {40463685},
  url = {https://pubmed.ncbi.nlm.nih.gov/40463685/},
  file = {Full Text PDF:https://mrthomaslef.github.io/biblio-marie/pdfs/PMID_40463685.pdf:application/pdf},
  abstract = {Le succès d'un DAIR (débridement, antibiothérapie et conservation de l'implant) dépend du type d'infection, du terrain, de l'état des parties molles, du germe, de la technique chirurgicale et de l'antibiothérapie. L'EBJIS définit les indications, contre-indications et facteurs de risque d'échec, et détaille la technique chirurgicale associée à l'antibiothérapie systémique.}
}

